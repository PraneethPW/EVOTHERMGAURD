APP_ENV=development
# A standard Neon postgresql:// URL is accepted and converted to asyncpg automatically.
DATABASE_URL=postgresql+asyncpg://user:password@host/database?ssl=require
JWT_SECRET=change-this-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_MODE=demo
MODEL_CHECKPOINT=
DATASET_MANIFEST=./dataset/manifest.csv
EXPERIMENTS_PATH=./models
STORAGE_PATH=./storage
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
