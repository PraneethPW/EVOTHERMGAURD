DATABASE_URL=postgresql+asyncpg://user:password@host/database?ssl=require
JWT_SECRET=change-this-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL_MODE=demo
MODEL_CHECKPOINT=
DATASET_MANIFEST=./backend/dataset/manifest.csv
EXPERIMENTS_PATH=./backend/models
STORAGE_PATH=./backend/storage
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8000/api/v1
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
MONITORING_POLL_SECONDS=30
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
CAMERA_SIMULATION_ENABLED=false
CAMERA_DATASET_PATH=./backend/dataset/camera

# Per-asset paired simulation datasets (bundled originals are synthetic).
CAMERA_DATASETS_PATH=./dataset/cameras

# Set the HTTPS backend origin when deployed behind a TLS-terminating proxy.
CAMERA_PUBLIC_BASE_URL=
